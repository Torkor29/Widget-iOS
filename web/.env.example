# Domain pointing to this VPS (A record) — no https://
DOMAIN=morni.app
SITE_URL=https://morni.app

# Supabase (Project Settings → API). The anon/publishable key is public.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# Universal links (apple-app-site-association)
APPLE_TEAM_ID=
IOS_BUNDLE_ID=app.morni.ios

# Shown on the site
NEXT_PUBLIC_APP_STORE_URL=
CONTACT_EMAIL=hello@morni.app
LEGAL_NAME=
LEGAL_ADDRESS=
